# ============================================================================
# SPECIAL RULES - EXCEPTIONS
# ============================================================================

# Keep these files even if they match ignore patterns above

# Important documentation
!README.md
!CHANGELOG.md
!MLFLOW_*.md

# Important configuration
!configs/config.example.yaml
!configs/config.test.yaml
!config_bin_*.yaml

# Important scripts
!run_*.sh

# Source code
!src/
!tests/
!bins/

# Configuration examples
!.env.example

old/
results/
AGENTS.md
resume_last_session.sh
